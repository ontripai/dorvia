{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/daily-case-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/exchange-lifecycle",
      "schedule": "0 5 * * *"
    }
  ]
}
