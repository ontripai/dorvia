# Supabase Public API Configuration (browser-safe anon key — page comments, etc.)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Admin Configuration (service_role key — NEVER expose to the browser).
# Feeds the unified `leads` table shared with the Telegram bot / WhatsApp.
# Used only in src/lib/supabaseAdmin.ts (server-side API routes).
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend Transactional Email (server-only)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=DORVIA <notifications@notifications.dorvia.ro>
DORVIA_LEADS_EMAIL=leads@example.com

# Telegram Dispatch (server-only, optional best-effort)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
